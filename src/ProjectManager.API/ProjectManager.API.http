@Host = http://localhost:5183

##################################################
# Auth
##################################################

### 1. Register User
# @name register
POST {{Host}}/api/users/register
Content-Type: application/json

{
  "email": "lead.architect@company.com",
  "password": "Password123!",
  "firstName": "John",
  "lastName": "Doe"
}

### 2. Login User
# @name login
POST {{Host}}/api/users/login
Content-Type: application/json

{
  "email": "lead.architect@company.com",
  "password": "Password123!"
}

### 3. Get Current Authenticated User (Me)
@token = {{login.response.body.token}}

GET {{Host}}/api/users/me
Authorization: Bearer {{token}}

##################################################
# Projects
##################################################

### 4. Create Project Without Token (Should return 401 Unauthorized)
POST {{Host}}/api/projects
Content-Type: application/json

{
  "name": "Unauthorized Project Creation",
  "description": "Should fail with 401"
}

### 5. Create Project With Token (OwnerId auto-populated from current user)
# @name createProject
POST {{Host}}/api/projects
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Clean Architecture & CQRS Platform",
  "description": "Enterprise platform with Feature-Based CQRS and JWT Authentication",
  "status": "Active",
  "startDate": "2026-09-01T00:00:00Z",
  "endDate": "2026-12-31T00:00:00Z"
}

### 6. Get All Projects (Authorized)
GET {{Host}}/api/projects
Authorization: Bearer {{token}}

##################################################
# Tasks
##################################################

### 7. Create Task (CreatedById auto-populated from current user)
@projectId = {{createProject.response.body.id}}

# @name createTask
POST {{Host}}/api/tasks
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "projectId": "{{projectId}}",
  "title": "Setup JWT Authentication & CurrentUserService",
  "description": "Enforce endpoint authorization and resolve current user ID from Claims",
  "priority": 2,
  "status": 1,
  "startDate": "2026-09-01T00:00:00Z",
  "dueDate": "2026-09-10T00:00:00Z",
  "estimatedHours": 12.0
}

##################################################
# Comments
##################################################

### 8. Create Comment (AuthorId auto-populated from current user)
@taskId = {{createTask.response.body.id}}

# @name createComment
POST {{Host}}/api/tasks/{{taskId}}/comments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "content": "Current user service automatically injected author ID from JWT token."
}

### 9. Get Comments For Task
GET {{Host}}/api/tasks/{{taskId}}/comments
Authorization: Bearer {{token}}

### 10. Update Comment
@commentId = {{createComment.response.body.id}}

PUT {{Host}}/api/comments/{{commentId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "content": "Updated comment content with edit timestamp."
}

##################################################
# Extended Tasks & Workflow
##################################################

### 11. Update Task Status (Patch)
PATCH {{Host}}/api/tasks/{{taskId}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "InProgress"
}

### 12. Assign Task (Patch)
PATCH {{Host}}/api/tasks/{{taskId}}/assign
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "assignedToId": "{{register.response.body.user.id}}"
}

### 13. Create Subtask
POST {{Host}}/api/tasks/{{taskId}}/subtasks
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Configure SymmetricSecurityKey in DI",
  "description": "Subtask to implement token validation parameters",
  "priority": "High",
  "status": "Pending",
  "estimatedHours": 3.0
}

### 14. Get Subtasks For Task
GET {{Host}}/api/tasks/{{taskId}}/subtasks
Authorization: Bearer {{token}}

### 15. Get Unassigned Tasks (Backlog)
GET {{Host}}/api/tasks/unassigned
Authorization: Bearer {{token}}

### 16. Get Overdue Tasks
GET {{Host}}/api/tasks/overdue
Authorization: Bearer {{token}}

##################################################
# Extended Projects
##################################################

### 17. Get All Tasks in Project (across all users)
GET {{Host}}/api/projects/{{projectId}}/tasks
Authorization: Bearer {{token}}

### 18. Get Project Summary & Metrics
GET {{Host}}/api/projects/{{projectId}}/summary
Authorization: Bearer {{token}}

### 19. Archive Project (Patch)
PATCH {{Host}}/api/projects/{{projectId}}/archive
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isArchived": true
}

##################################################
# Extended Users & Team Collaboration
##################################################

### 20. Search & List Users
GET {{Host}}/api/users?searchTerm=John
Authorization: Bearer {{token}}

### 21. Update Profile (Me)
PUT {{Host}}/api/users/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Architect"
}

##################################################
# Dashboard
##################################################

### 22. Get My Dashboard
GET {{Host}}/api/dashboard/me
Authorization: Bearer {{token}}
